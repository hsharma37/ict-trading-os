# ────────────────────────────────────────────────
# ICT Trading OS v9.1.0 — Environment Configuration
# Copy this file to .env and fill in your values
# ────────────────────────────────────────────────

# ── Database (SQLite — zero-config, survives restarts)
DATABASE_PATH=ictos.db

# ── API Server
API_HOST=0.0.0.0
API_PORT=8000

# ── Auth (optional — set AUTH_ENABLED=true and API_KEY to enable)
AUTH_ENABLED=false
API_KEY=change-me-in-production
JWT_SECRET=change-me-in-production-64-char-random-string

# ── Frontend
VITE_API_URL=http://localhost:8000
VITE_WS_URL=ws://localhost:8000/ws

# ── AI / Ollama
OLLAMA_HOST=http://localhost:11434
OLLAMA_MODEL=llama3.1:8b
EMBEDDING_MODEL=nomic-embed-text:latest

# ── MT5 Bridge (run natively on your machine, not in Docker)
MT5_BRIDGE_URL=http://localhost:5000

# ── Telegram Notifications
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# ── Logging
LOG_LEVEL=INFO

# ── Development
PYTHON_ENV=development
NODE_ENV=development
