# ────────────────────────────────────────────────
# ICT Trading OS — Environment Configuration
# Copy this file to .env and fill in your values
# ────────────────────────────────────────────────

# Database
POSTGRES_USER=ictos
POSTGRES_PASSWORD=ictos
POSTGRES_DB=ictos
DATABASE_URL=postgresql://ictos:ictos@localhost:5432/ictos

# Redis
REDIS_URL=redis://localhost:6379/0

# API
API_HOST=0.0.0.0
API_PORT=8000
API_SECRET_KEY=change-me-in-production-use-64-char-random-string

# Frontend
VITE_API_URL=http://localhost:8000
VITE_WS_URL=ws://localhost:8000/ws

# AI / Ollama
OLLAMA_HOST=http://localhost:11434
OLLAMA_MODEL=llama3.1:8b
EMBEDDING_MODEL=nomic-embed-text:latest

# Celery
CELERY_BROKER_URL=redis://localhost:6379/0
CELERY_RESULT_BACKEND=db+postgresql://ictos:ictos@localhost:5432/ictos

# MT5 Bridge (run natively on your machine, not in Docker)
MT5_BRIDGE_URL=http://localhost:5000

# Telegram Notifications
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Logging
LOG_LEVEL=INFO

# Development
PYTHON_ENV=development
NODE_ENV=development
