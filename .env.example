# ────────────────────────────────────────────────
# ICT Trading OS v9.1.0 — Environment Configuration
# Copy this file to .env and fill in your values
# ────────────────────────────────────────────────

# ── Runtime
APP_ENV=development
STORAGE_BACKEND=auto

# ── Database (Postgres + pgvector recommended)
# Use a local pgvector database, for example the postgres service in docker-compose.
DATABASE_URL=postgresql://localhost:5432/ictos_dev

# SQLite is allowed only for local throwaway development/tests when DATABASE_URL is empty.
DATABASE_PATH=ictos.db
ALLOW_SQLITE_RUNTIME=true

# ── API Server
API_HOST=0.0.0.0
API_PORT=8000

# ── Auth
# Local development is open by default. Set AUTH_ENABLED=true to test the
# production safety gate locally. Preview/production require API auth by default.
AUTH_ENABLED=
API_KEY=change-me-in-production
JWT_SECRET=change-me-in-production-64-char-random-string

# ── Frontend
VITE_API_URL=http://localhost:8000
VITE_WS_URL=ws://localhost:8000/ws

# ── AI / Ollama
OLLAMA_HOST=http://localhost:11434
OLLAMA_MODEL=llama3.1:8b
EMBEDDING_MODEL=nomic-embed-text:latest

# ── Market Data Provider
# auto  = use OANDA when OANDA_* are set, otherwise Yahoo Finance (default)
# oanda = force OANDA (falls back to Yahoo per-symbol if unmapped/unavailable)
# yahoo = force Yahoo Finance and ignore OANDA
# mt5   = price from the MT5 bridge (broker feed, matches fills; needs MT5_BRIDGE_URL)
MARKET_DATA_PROVIDER=auto

# ── OANDA v20 (real-time FX / metals / index-CFD feed; data-only, no order placement)
# Create a free practice account at https://www.oanda.com, then in fxTrade:
#   Manage API Access -> generate a personal access token,
#   and copy your v20 Account ID (e.g. 101-001-1234567-001).
OANDA_API_TOKEN=
OANDA_ACCOUNT_ID=
OANDA_ENV=practice   # practice | live

# ── MT5 Bridge (run natively on the same machine as your MT5 terminal, not in Docker)
# See mt5-bridge/README.md for full setup (Windows + MetaTrader5 required).
MT5_BRIDGE_URL=http://localhost:5000
# Must match MT5_BRIDGE_API_KEY set on the bridge itself, once it's reachable
# over the internet (e.g. via a tunnel). Leave both empty for local dev only.
MT5_BRIDGE_API_KEY=
# MT5 execution guardrails. Empty allowlist = all configured instruments.
MT5_ALLOWED_SYMBOLS=
MT5_MAX_LOT=10
MT5_REQUIRE_SL=false

# ── Telegram Notifications
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# ── Logging
LOG_LEVEL=INFO

# ── Development
PYTHON_ENV=development
NODE_ENV=development
