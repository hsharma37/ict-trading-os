# ICT Trading OS production environment
# Copy into Vercel Production environment variables for the main project/branch.

APP_NAME=ICT Trading OS API
APP_VERSION=9.1.0
DATABASE_PATH=/tmp/ictos.db
PRICE_CACHE_DIR=/tmp

# The current frontend does not have a private auth/session flow yet.
# Keep this false for demo/internal deployments, or add a server-side auth proxy before enabling.
AUTH_ENABLED=false
API_KEY=replace-with-production-api-key
JWT_SECRET=replace-with-production-random-secret
CORS_ORIGINS=https://app.yourdomain.com

VITE_API_URL=https://api.yourdomain.com
VITE_WS_URL=wss://api.yourdomain.com/ws

OLLAMA_HOST=http://localhost:11434
OLLAMA_MODEL=llama3.1:8b
EMBEDDING_MODEL=nomic-embed-text:latest

MT5_BRIDGE_URL=http://localhost:5000
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHANNEL_ID=
LOG_LEVEL=INFO
PYTHON_ENV=production
NODE_ENV=production
