# ICT Trading OS production environment
# Copy into Vercel Production environment variables for the main project/branch.

APP_NAME=ICT Trading OS API
APP_VERSION=9.1.0
APP_ENV=production
STORAGE_BACKEND=postgres
DATABASE_URL=postgresql://prod-user@prod-host:5432/tradingos_prod
DATABASE_SCHEMA=tradingos_prod
PRICE_CACHE_DIR=/tmp

# Production protects private and mutating API routes by default, even if
# AUTH_ENABLED is accidentally left false. Keep Vercel Deployment Protection on
# until a first-party frontend session flow exists.
AUTH_ENABLED=true
REQUIRE_API_AUTH=true
ALLOW_PUBLIC_API_MUTATIONS=false
API_KEY=replace-with-production-64-char-random-api-key
JWT_SECRET=replace-with-production-random-secret
CORS_ORIGINS=https://app.yourdomain.com

VITE_API_URL=/api
VITE_WS_URL=wss://app.yourdomain.com/ws

OLLAMA_HOST=http://localhost:11434
OLLAMA_MODEL=llama3.1:8b
EMBEDDING_MODEL=nomic-embed-text:latest

# Do not point production Vercel at a live MT5 bridge until bridge allowlisting,
# API auth, and manual approval are configured.
MT5_BRIDGE_URL=
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHANNEL_ID=
LOG_LEVEL=INFO
PYTHON_ENV=production
NODE_ENV=production
