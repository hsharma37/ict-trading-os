# ICT Trading OS preview/staging environment
# Copy into Vercel Preview environment variables for the dev project/branch.

APP_NAME=ICT Trading OS API Preview
APP_VERSION=9.1.0
APP_ENV=preview
STORAGE_BACKEND=postgres
DATABASE_URL=postgresql://preview-user@preview-host:5432/tradingos_preview
DATABASE_SCHEMA=tradingos_preview
PRICE_CACHE_DIR=/tmp

# Preview protects private and mutating API routes by default. Use separate
# preview secrets and keep live execution integrations disabled.
AUTH_ENABLED=true
REQUIRE_API_AUTH=true
ALLOW_PUBLIC_API_MUTATIONS=false
API_KEY=replace-with-preview-64-char-random-api-key
JWT_SECRET=replace-with-preview-random-secret
CORS_ORIGINS=https://dev.yourdomain.com,http://localhost:3000,http://localhost:5173

VITE_API_URL=/api
VITE_WS_URL=wss://dev.yourdomain.com/ws

OLLAMA_HOST=http://localhost:11434
OLLAMA_MODEL=llama3.1:8b
EMBEDDING_MODEL=nomic-embed-text:latest

MT5_BRIDGE_URL=
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHANNEL_ID=
LOG_LEVEL=INFO
PYTHON_ENV=preview
NODE_ENV=production
