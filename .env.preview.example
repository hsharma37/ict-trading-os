# ICT Trading OS preview/staging environment
# Copy into Vercel Preview environment variables for the dev project/branch.

APP_NAME=ICT Trading OS API Preview
APP_VERSION=9.1.0
APP_ENV=preview
STORAGE_BACKEND=postgres
DATABASE_URL=postgresql://preview-user:preview-password@preview-host:5432/tradingos_preview
PRICE_CACHE_DIR=/tmp

# The current frontend does not have a private auth/session flow yet.
# Keep this false for demo/dev URLs, or add a server-side auth proxy before enabling.
AUTH_ENABLED=false
API_KEY=replace-with-preview-api-key
JWT_SECRET=replace-with-preview-random-secret
CORS_ORIGINS=https://dev.yourdomain.com,http://localhost:3000,http://localhost:5173

VITE_API_URL=https://api-dev.yourdomain.com
VITE_WS_URL=wss://api-dev.yourdomain.com/ws

OLLAMA_HOST=http://localhost:11434
OLLAMA_MODEL=llama3.1:8b
EMBEDDING_MODEL=nomic-embed-text:latest

MT5_BRIDGE_URL=http://localhost:5000
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHANNEL_ID=
LOG_LEVEL=INFO
PYTHON_ENV=preview
NODE_ENV=production
