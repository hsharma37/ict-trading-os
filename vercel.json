{
  "version": 2,
  "buildCommand": "echo 'Frontend pre-built'",
  "outputDirectory": "frontend/dist",
  "routes": [
    { "handle": "filesystem" },
    { "src": "/api/(.*)", "dest": "/api/index" },
    { "src": "/health", "dest": "/api/index" },
    { "src": "/docs", "dest": "/api/index" },
    { "src": "/openapi.json", "dest": "/api/index" },
    { "src": "/redoc", "dest": "/api/index" },
    { "src": "/(.*)", "dest": "/index.html" }
  ]
}
