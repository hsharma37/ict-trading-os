{
  "version": 2,
  "buildCommand": "cp -r frontend/dist/* public/",
  "rewrites": [
    { "source": "/assets/(.*)", "destination": "/assets/$1" },
    { "source": "/vite.svg", "destination": "/vite.svg" },
    { "source": "/api/(.*)", "destination": "/api/index" },
    { "source": "/health", "destination": "/api/index" },
    { "source": "/docs", "destination": "/api/index" },
    { "source": "/openapi.json", "destination": "/api/index" },
    { "source": "/redoc", "destination": "/api/index" },
    { "source": "/index.html", "destination": "/index.html" },
    { "source": "/$", "destination": "/index.html" },
    { "source": "/(.*)", "destination": "/index.html" }
  ]
}
