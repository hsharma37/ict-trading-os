# MT5 Bridge configuration.
# Run this bridge on the SAME Windows machine as a running, logged-in
# MetaTrader 5 terminal. Copy this file to `.env` in this directory.

MT5_BRIDGE_PORT=5000

# MetaTrader5 terminal login (from your broker/MetaQuotes demo or live account).
MT5_LOGIN=
MT5_PASSWORD=
MT5_SERVER=
# Optional: full path to terminal64.exe if MT5 isn't installed in the default location.
MT5_TERMINAL_PATH=

# Shared secret required on every request (except /health) once this bridge
# is reachable from the internet (e.g. via ngrok/Cloudflare Tunnel). Generate
# one with: openssl rand -hex 32
# Must match MT5_BRIDGE_API_KEY set on the main app (Vercel).
MT5_BRIDGE_API_KEY=

# Optional: Telegram notifications for trade execution/close, sent directly
# from this bridge (separate from the main app's Telegram signal feed).
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

LOG_LEVEL=INFO
