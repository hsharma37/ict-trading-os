# ICT Trading OS — Updated .gitignore (Monorepo)
# See https://git-scm.com/docs/gitignore

# ────────────────────────────────────────────────
# OS
# ────────────────────────────────────────────────
.DS_Store
Thumbs.db
*.swp
*.swo

# ────────────────────────────────────────────────
# Environment / Secrets
# ────────────────────────────────────────────────
.env
.env.local
.env.production
*.env.*
!/.env.example
!/.env.sample

# ────────────────────────────────────────────────
# Python / Backend
# ────────────────────────────────────────────────
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
build/
develop-eggs/
dist/
downloads/
eggs/
.eggs/
lib/
lib64/
parts/
sdist/
var/
wheels/
*.egg-info/
.installed.cfg
*.egg
MANIFEST

# Virtual environments
venv/
ENV/
env/
.venv/

# Pytest / Coverage
.pytest_cache/
.coverage
htmlcov/
.tox/

# MyPy
.mypy_cache/
.dmypy.json

# Ruff
.ruff_cache/

# ────────────────────────────────────────────────
# Node / Frontend
# ────────────────────────────────────────────────
node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# Vite
frontend/dist/
frontend/dist-ssr/
*.local

# TypeScript
*.tsbuildinfo

# ────────────────────────────────────────────────
# Docker
# ────────────────────────────────────────────────
docker-compose.override.yml

# ────────────────────────────────────────────────
# IDE / Editor
# ────────────────────────────────────────────────
.vscode/
.idea/
*.sublime-project
*.sublime-workspace

# ────────────────────────────────────────────────
# Logs
# ────────────────────────────────────────────────
*.log
logs/

# ────────────────────────────────────────────────
# Data / Volumes (if mounted locally)
# ────────────────────────────────────────────────
postgres_data/
redis_data/
ollama_data/
