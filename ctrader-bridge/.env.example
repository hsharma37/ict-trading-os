# ── Transport ────────────────────────────────────────────────────────────
# "fix" (default): FIX 4.4 sessions — needs only the account's FIX password.
# "openapi": protobuf Open API — needs client id/secret/access token.
CT_TRANSPORT=fix

# ── FIX 4.4 (CT_TRANSPORT=fix) — from your broker's FIX credentials sheet ─
CT_FIX_HOST=demo-uk-eqx-01.p.c-trader.com
CT_FIX_SSL_PORT=5211
CT_FIX_PLAIN_PORT=5201
CT_FIX_USE_SSL=1
CT_FIX_SENDER_COMP_ID=demo.ctrader.YOUR_ACCOUNT
CT_FIX_PASSWORD=

# ── Open API (CT_TRANSPORT=openapi) ─────────────────────────────────────
CT_CLIENT_ID=
CT_CLIENT_SECRET=
CT_ACCESS_TOKEN=

# ── Shared ───────────────────────────────────────────────────────────────
CT_ACCOUNT_ID=
CT_HOST_TYPE=demo
CTRADER_BRIDGE_PORT=5001
MT5_BRIDGE_API_KEY=
