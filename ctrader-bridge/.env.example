# ── cTrader Open API credentials ─────────────────────────────────────────
# Create an application at https://openapi.ctrader.com → you get the client
# id/secret. Connect your trading account to the app (cTrader mobile/web →
# Settings → Advanced → API access, or the developer portal) → you get the
# access token + account id.
CT_CLIENT_ID=
CT_CLIENT_SECRET=
CT_ACCESS_TOKEN=
CT_ACCOUNT_ID=
CT_HOST_TYPE=demo            # demo | live

# ── Bridge ───────────────────────────────────────────────────────────────
CTRADER_BRIDGE_PORT=5000
# Shared secret; must match the app's MT5_BRIDGE_API_KEY (provider-agnostic
# name kept so the app needs one secret regardless of bridge type).
MT5_BRIDGE_API_KEY=

# ── Optional: Telegram notifications from this bridge ────────────────────
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# ── Optional: run the app's always-on schedulers from here ───────────────
# APP_BASE_URL=https://ict-trading-os-rho.vercel.app
# APP_POLL_INTERVAL_MINUTES=60
# CRON_SECRET=

LOG_LEVEL=INFO
